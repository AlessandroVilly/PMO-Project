% --- 1. Definizione Colori ---
\definecolor{opcolor}{HTML}{B124B0}   % Rosa per operatori
\definecolor{brakcolor}{HTML}{D74C14} % Arancione per parentesi
\definecolor{keycolor}{HTML}{2469B1} % Blu scuro per keyword
\definecolor{bggray}{gray}{0.97}          % Grigio chiarissimo per sfondo
\newcommand{\myAmp}{{\color{opcolor}\&}}
\newcommand{\myDoll}{{\color{opcolor}\$}}
\newcommand{\myApic}{{\color{opcolor}\^}}
\lstdefinestyle{CColorful}{
    language=C,      % Imposta il C come base (PRIMA di tutto)
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{bggray},
    keywordstyle=\color{keycolor}\bfseries,
    commentstyle=\textcolor[HTML]{3D1F96},
    stringstyle=\textcolor[HTML]{198100},
    numbers=left,
    numberstyle=\small\color{gray},
    frame=single,
    rulecolor=\color{gray!50},
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    showstringspaces=false,
    % --- BLOCCO LITERATE ---
    % Nota: L'intera lista è racchiusa tra { ... } aggiuntivi.
    % Questo protegge le parentesi ) e le virgole interne dal parser.
    literate={
        {+}{{{\color{opcolor}+}}}1
        {-}{{{\color{opcolor}-}}}1
        % {*}{{{\color{opcolor}*}}}1
        % {/}{{{\color{opcolor}/}}}1
        {=}{{{\color{opcolor}=}}}1
        {>}{{{\color{opcolor}>}}}1
        {<}{{{\color{opcolor}<}}}1
        {!}{{{\color{opcolor}!}}}1
        {?}{{{\color{opcolor}?}}}1
        % Ampersand protetta con backslash
        {&}{\myAmp}1
        % Parentesi colorate (non danno più errore grazie alle graffe esterne)
        {)}{{{\color{brakcolor})}}}1
        {[}{{{\color{brakcolor}[}}}1
        {]}{{{\color{brakcolor}]}}}1
        {\{}{{{\color{brakcolor}\{}}}1
        {\}}{{{\color{brakcolor}\}}}}1
        % Punteggiatura extra
    }
}

\lstdefinestyle{MakeColorful}{
    language=make,      % Imposta il C come base (PRIMA di tutto)
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{bggray},
    keywordstyle=\color{keycolor}\bfseries,
    commentstyle=\color{green!60!black},
    stringstyle=\textcolor[HTML]{198100},
    numbers=left,
    numberstyle=\small\color{gray},
    frame=single,
    rulecolor=\color{gray!50},
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    showstringspaces=false,
    % --- BLOCCO LITERATE ---
    % Nota: L'intera lista è racchiusa tra { ... } aggiuntivi.
    % Questo protegge le parentesi ) e le virgole interne dal parser.
    literate={
        {+}{{{\color{opcolor}+}}}1
        {-}{{{\color{opcolor}-}}}1
        {*}{{{\color{opcolor}*}}}1
        {/}{{{\color{opcolor}/}}}1
        {=}{{{\color{opcolor}=}}}1
        {>}{{{\color{opcolor}>}}}1
        {:}{{{\color{opcolor}:}}}1
        {<}{{{\color{opcolor}<}}}1
        {!}{{{\color{opcolor}!}}}1
        {@}{{{\color{opcolor}@}}}1
        {?}{{{\color{opcolor}?}}}1
        % & deve essere preceduto da backslash
        {&}{{{\color{opcolor}\&}}}1 
        % $ deve essere preceduto da backslash
        {$}{{{\color{opcolor}\$}}}1 
        % ^ richiede il comando \textasciicircum
        {^}{{{\color{opcolor}\textasciicircum}}}1
        % Parentesi colorate (non danno più errore grazie alle graffe esterne)
        {)}{{{\color{brakcolor})}}}1
        {[}{{{\color{brakcolor}[}}}1
        {]}{{{\color{brakcolor}]}}}1
        {\{}{{{\color{brakcolor}\{}}}1
        {\}}{{{\color{brakcolor}\}}}}1
        % Punteggiatura extra
        {.PHONY}{{{\color{red}.PHONY}}}1
    }
}

