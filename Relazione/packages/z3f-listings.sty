% Inizializzazione di un contatore
\newcounter{mintedcnt}
\counterwithin{mintedcnt}{chapter}
\renewcommand{\themintedcnt}{\thechapter.\arabic{mintedcnt}}

% La dimensione dei numeri di riga va impostata prima poichè non viene letta correttamente
\renewcommand{\theFancyVerbLine}{\textcolor{black}{\footnotesize\arabic{FancyVerbLine}}}
% Configurazione globale per tutti gli ambienti minted del documento
\setminted{
    linenos=true,          % Abilita l'indicizzazione dei numeri di riga
    numbersep=6pt,
    frame=lines,          % Genera un box perimetrale completo (alternative: lines, topandbottom)
    fontsize=\normalsize,
    framesep=1mm,          % Definisce il padding interno (la colla tra testo e bordo)
    rulecolor=black,       % Colore della linea del box
    % fontsize=\footnotesize, % Riduce leggermente il font per una migliore resa nel layout
    autogobble,
    escapeinside={(*@}{@*)}      % non funziona su stringhe, \|\|
    %bgcolor=sfondocodice
}

% \NewDocumentEnvironment sostituisce \newenvironment offrendo un parser più robusto.
% Firma degli argomenti:
% O{0.8\textwidth} -> #1: Argomento opzionale (larghezza minipage), default 80% della gabbia
% m                -> #2: Argomento obbligatorio (linguaggio di programmazione)
% m                -> #3: Argomento obbligatorio (testo della didascalia)
% m                -> #4: Argomento obbligatorio (label per i cross-reference)

\DeclareTCBListing{mintedcodebox}{ O{0.8\textwidth} m m }{
    % Configurazione del motore verbatim
    listing engine=minted,
    listing only,
    minted language=#2,
    % Configurazione strutturale (sostituisce center e minipage)
    width=#1,
    center,
    % Configurazione estetica del frame (emula frame=single di minted)
    enhanced,
    breakable,
    sharp corners,
    interior hidden,
    frame hidden,
    boxrule=0pt,
    step=mintedcnt,
    % Gestione automatizzata di didascalia e label
    title={#3},
    detach title, % Rimuove visivamente il titolo dal margine superiore
    % Inietta la didascalia formattata sotto il riquadro.
    % \thetcbcounter richiama dinamicamente il numero del listing.
    after={
        \par\vspace{-1.8ex}
        \noindent\centering
        \small\textbf{Codice \themintedcnt:} #3
        \par\vspace{1.5ex}
    },
    label={lst:\themintedcnt}
}
