\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{z3f-stylepage-legacy}[2026/09/05 Stile tipografico basato su classi standard]

\RequirePackage{geometry}
\RequirePackage[explicit]{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[parfill]{parskip}
\RequirePackage{pgfornament}
\RequirePackage{pgfornament-han}

% Usando il package showframe, si possono mostrare i bordi della pagina %
% \RequirePackage{showframe}
\geometry{ marginparwidth = 0mm,
           marginparsep = 0mm,
           headsep = 3mm,
           footskip = 15pt, % minimo sindacale per footskip
           top=10mm,
           bottom=10mm,
           right=10mm,
           left=10mm}
\pagestyle{fancy}
\fancyhf{}
\setlength{\headheight}{15pt}
\addtolength{\topmargin}{-2.49998pt}
% Definizione del token tipografico per il filetto centrato verticalmente
% I parametri height e depth regolano rispettivamente lo spessore e l'elevazione
\newcommand{\midlinefill}{\leavevmode\leaders\hrule height 0.7ex depth -0.5ex\hfill}
% Disattivazione esplicita dei filetti continui nativi di fancyhdr
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Ridefinizione del token \chaptermark per iniettare l'etichetta, il numero e il nome
\renewcommand{\chaptermark}[1]{\markboth{\thechapter\ \triangleright \ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
% Iniezione del layout nell'intestazione (Header)
% \makebox[\headwidth] costringe il contenuto a occupare l'esatta larghezza della gabbia di testo
% \quad fornisce una spaziatura rigida tra il filetto elastico e il contenuto testuale
\fancyhead[C]{%
  \makebox[\headwidth]{\raisebox{0.14em}{\pgfornamenthan[height=0.8em, symmetry=c]{70}}~\midlinefill\quad{\leftmark \ \triangleright \ \rightmark}\quad\midlinefill~\raisebox{0.14em}{\pgfornamenthan[height=0.8em, symmetry=h]{70}}}%
}

% Iniezione del layout nel piè di pagina (Footer)
\fancyfoot[C]{%
  \makebox[\headwidth]{\raisebox{0.34em}{\pgfornamenthan[height=0.8em, symmetry=v]{70}}~\midlinefill\quad\thepage\quad\midlinefill~\raisebox{0.34em}{\pgfornamenthan[height=0.8em]{70}}}%
}

% 1. RIDEFINIAMO IL FORMATO (Obbligatorio per far funzionare la spaziatura)
% Questo replica lo stile standard "Capitolo X" a capo "Titolo"
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\centering} % Stile generale
  {\raisebox{0.65ex}{{\pgfornament[height=0.8em]{11}}} Capitolo \thechapter~\raisebox{0.65ex}{\pgfornament[height=0.8em]{14}}}          % Etichetta (es. "Capitolo 1")
  {0pt}           % Spazio tra "Capitolo 1" e "Titolo del capitolo"
  {#1}            % Stile del titolo vero e proprio

% 2. RIDEFINIAMO LA SPAZIATURA (Qui riduciamo lo spazio)
\titlespacing*{\chapter}
  {0pt} % Spazio a sinistra
  {0pt} % Spazio PRIMA del titolo (dall'alto della pagina)
  {3pt} % <--- SPAZIO DOPO IL TITOLO

% --- Configurazione \section ---
\titleformat{\section}
  {\normalfont\LARGE\bfseries\centering}
  {\raisebox{0.55ex}{\pgfornament[height=0.6em]{3}}~\thesection :~}
  {0pt}            % Spazio orizzontale tra numero e testo del titolo
  {#1 \raisebox{0.55ex}{\pgfornament[height=0.6em, symmetry=v]{3}}}
  
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{2.3ex plus .2ex}

% --- Configurazione \subsection ---
\titleformat{\subsection}
  {\normalfont\Large\bfseries\centering}
  {\raisebox{0.55ex}{\pgfornament[height=0.4em]{2}}~}
  {0pt}
  {#1~\raisebox{0.55ex}{\pgfornament[height=0.4em, symmetry=v]{2}}}
  
\titlespacing*{\subsection}{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}

% --- Configurazione \subsubsection ---
% La forma [runin] formatta il titolo come parte del paragrafo (sulla stessa riga del testo)
\titleformat{\subsubsection}
  {\normalfont\large\bfseries\centering}
  {\thesubsubsection}
  {0pt}
  {#1}                       % Aggiunge spazio (quad) dopo il titolo, prima del testo
  
\titlespacing*{\subsubsection}{0pt}{3.25ex plus 1ex minus .2ex}{0.75ex plus .1ex}


