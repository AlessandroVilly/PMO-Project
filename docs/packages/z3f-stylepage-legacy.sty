\newif\ifLogo
\newif\ifInstitute
\newif\ifFaculty
\newif\ifDepartment
\newif\ifSubtitle
\newif\ifSupervisor
\newif\ifContext
\newif\ifDate

\newcommand*{\logo}[1]{\gdef\@logo{#1}\global\Logotrue}
\newcommand*{\institute}[1]{\gdef\@institute{#1}\global\Institutetrue}
\newcommand*{\faculty}[1]{\gdef\@faculty{#1}\global\Facultytrue}
\newcommand*{\department}[1]{\gdef\@department{#1}\global\Departmenttrue}
\newcommand*{\subtitle}[1]{\gdef\@subtitle{#1}\global\Subtitletrue}
\newcommand*{\supervisor}[1]{\gdef\@supervisor{#1}\global\Supervisortrue}
\newcommand*{\context}[1]{\gdef\@context{#1}\global\Contexttrue}
\renewcommand*{\date}[1]{\gdef\@date{#1}\global\Datetrue}

%%%%%%%%%%%%%%%%%%%%%
% PAGINA DEL TITOLO %
%%%%%%%%%%%%%%%%%%%%%
\makeatletter

\renewcommand*{\maketitle}{%
  \begin{titlepage}%
    % 1. Impostiamo la geometria specifica per questa pagina
    \newgeometry{left=2.5cm,right=2.5cm,top=2.5cm,bottom=2.5cm}%
    
    % 2. Reset totale dei parametri di spaziatura parassita
    \setlength{\parindent}{0pt}
    \setlength{\parskip}{0pt}
    \setlength{\headheight}{0pt}
    \setlength{\footskip}{0pt}
    
    % Centratura globale della pagina
    \centering

    % --- BLOCCO SUPERIORE ---
    % Inseriamo il contenuto senza minipage avvolgenti inutili
    \vspace*{0.5cm} % Piccolo margine superiore di sicurezza
    
    \ifLogo
      \includegraphics[height=0.15\textheight, keepaspectratio]{\@logo}\par
      \vspace{1.5cm plus 1cm minus 1cm} % Spazio elastico sotto il logo
    \else
      \vspace*{1cm} % Se non c'è logo, spazio vuoto
    \fi

    {\scshape
      \ifInstitute\LARGE\@institute\par\fi
      \ifFaculty
        \ifInstitute\vspace{0.5em}\fi % Spazio ridotto tra istituto e facoltà
        \Large\@faculty\par
      \fi
      \ifDepartment\vspace{0.5em}\large\@department\par\fi
    }

    \vfill % <--- PRIMA MOLLA (Spinge il titolo verso il centro/basso)

    % --- TITOLO ---
    % mdframed gestisce il suo spazio. 
    % userdefinedwidth=\dimexpr\textwidth-4pt\relax compensa lo spessore delle linee per evitare Overfull hbox
    \begin{mdframed}[%
      linewidth=2pt,
      innertopmargin=1.5em,
      innerbottommargin=1.5em,
      leftline=false,
      rightline=false,
      userdefinedwidth=\textwidth, 
      align=center,
      skipabove=0pt,
      skipbelow=0pt]
      \centering
      {\bfseries\huge\@title\par}
    \end{mdframed}

    \vfill % <--- SECONDA MOLLA (Spinge il footer in basso)

    % --- BLOCCO INFERIORE ---
    \ifSubtitle
      {\Large\@subtitle\par}
      \vspace{1.5cm plus 1cm minus 1cm}
    \fi
    
    \ifSupervisor
      % Usiamo una tabella invisibile invece di minipage affiancate 
      % (più stabile per l'allineamento)
      \vspace{1cm}
      \noindent
      \begin{tabular*}{\textwidth}{@{}l@{\extracolsep{\fill}}r@{}}
        %{\large \textbf{Candidato:}} & {\large \textbf{Relatore:}} \\
        {\large \@author} & {\large \@supervisor}
      \end{tabular*}
    \else
      {\large\@author\par}
    \fi

    \vfill 
    \begin{minipage}{\textwidth}
      \centering
      \ifContext
      {\large\@context\par}
    \fi
    \ifDate
      {\large\@date\par}
    \fi
    \end{minipage}
    
    \vspace*{0cm} % Margine inferiore di sicurezza

  \end{titlepage}%
  \restoregeometry
}
\makeatother


