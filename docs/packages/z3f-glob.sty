\RequirePackage{mathtools} % Carica amsmath + estensioni + fix
\mathtoolsset{mathic=true}
\RequirePackage{unicode-math}
\RequirePackage{cancel}
\RequirePackage{fontspec}
\DeclarePairedDelimiter{\rbk}{(}{)}
\DeclarePairedDelimiter{\cbk}{\{}{\}}
\DeclarePairedDelimiter{\sbk}{[}{]}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}

% Operatori e formattazione specifica
\newcommand{\fact}[1]{#1!}
% L'operatore differenziale richiede una spaziatura dedicata fornita da \mathop{}\!
\newcommand{\diff}{\mathop{}\!\mathrm{d}}
\DeclareMathOperator{\tr}{tr}

%%%%%%%%%%%%%%
% SPAZIATURA %
%%%%%%%%%%%%%%

% Definizione di un comando utente per riconfigurare gli spazi al volo se necessario
\newcommand{\setmathspacing}[1]{%
    \setlength{\abovedisplayskip}{#1}%
    \setlength{\belowdisplayskip}{#1}%
    \setlength{\abovedisplayshortskip}{#1}%
    \setlength{\belowdisplayshortskip}{#1}%
}

% Applicazione automatica all'inizio del documento
\AtBeginDocument{%
    % Valori personalizzati. Modifica questi numeri secondo le tue esigenze.
    \setlength{\abovedisplayskip}{7pt plus 2pt minus 2pt}%
    \setlength{\belowdisplayskip}{7pt plus 2pt minus 2pt}%
    \setlength{\abovedisplayshortskip}{0pt plus 2pt}%
    \setlength{\belowdisplayshortskip}{6pt plus 2pt minus 2pt}%
}

%%%%%%%%
% FONT %
%%%%%%%%

% Carica la famiglia Libertinus (Serif, Sans, Mono)
\setmainfont{Libertinus Serif}[
    Ligatures=TeX,
    Numbers=OldStyle % Opzionale: numeri elzeviriani per il testo discorsivo
]

\setsansfont{Libertinus Sans}[
    Ligatures=TeX,
    Scale=MatchLowercase % Sincronizza l'altezza della x (x-height) con il Serif
]
\RequirePackage{wela} %handwritten font
\RequirePackage{calligra} %handwritten font
\RequirePackage{miama} %handwritten font
\RequirePackage{aurical} %handwritten font

\setmathfont{LibertinusMath-Regular.otf}[
    Extension    = .otf,
    BoldFont     = LibertinusMath-Regular.otf, % Riusiamo il Regular per il Bold
    BoldFeatures = {FakeBold=2},             % Applicando il grassetto finto
]

% A questo punto, il sistema SA cos'è il grassetto per Libertinus.
% Ora possiamo mappare \symbf e \symbfit.

% Mapping per \symbf (Grassetto Dritto)
\setmathfont{LibertinusMath-Regular.otf}
[
    range={bfup},
    FakeBold=1.5,
    Scale=MatchLowercase
]

% Mapping per \symbfit (Grassetto Italico)
\setmathfont{LibertinusMath-Regular.otf}[
    range={bfit},
    FakeBold=1.5,
    Scale=MatchLowercase
]

% Patch per i glifi mancanti -> bas
\setmathfont{STIXTwoMath-Regular.otf}[
    range={"22BB, "2A1D},
    Scale=MatchLowercase
]


\setmonofont{JetBrainsMono-Regular}[
  AutoFakeSlant = 0.2,  
  Scale=MatchLowercase
]
